{
  "expo": {
    "name": "BudVia",
    "slug": "belvia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "belvia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.belvia.trip"
    },
    "android": {
      "package": "app.belvia.trip",
      "adaptiveIcon": { "backgroundColor": "#000000" },
      "navigationBarColor": "#000000"
    },
    "plugins": ["expo-router", "expo-system-ui", "expo-blur", "@shopify/react-native-skia"],
    "experiments": { "typedRoutes": true }
  }
}
